---
/**
 * One bibliographic entry row used inside `<ol class="pub-list">`.
 * The wrapping <li> carries data attributes (`data-type`, `data-year`,
 * `data-topics`) that the client-side filter script on publications.astro
 * reads to show/hide entries.
 */
import type { Lang } from '@i18n/index';
import type { CollectionEntry } from 'astro:content';

// Single source of truth: derive the row's shape from the content schema
// (src/content/config.ts) so the bib2json output, the Zod schema, and this
// component can never drift apart.
type Paper = CollectionEntry<'papers'>['data'];

export interface Props {
  paper: Paper;
  lang: Lang;
}

const { paper, lang } = Astro.props;

function displayAuthor(name: string, lang: Lang): string {
  if (name.includes(',')) {
    const [last, first] = name.split(',').map((s) => s.trim());
    return lang === 'ja' ? `${last}, ${first}` : `${first} ${last}`;
  }
  return name;
}

// Role label for edited / editorial-board works (not authorship).
function roleLabel(role: string, lang: Lang): string {
  const ja: Record<string, string> = {
    'joint-editor': '共編',
    'student-editor': '学生編集委員',
    editor: '編'
  };
  const en: Record<string, string> = {
    'joint-editor': 'Joint editor',
    'student-editor': 'Student editorial board',
    editor: 'ed.'
  };
  return (lang === 'ja' ? ja[role] : en[role]) ?? (lang === 'ja' ? '編' : 'ed.');
}

function displayTitle(paper: Paper, lang: Lang): string {
  if (lang === 'en' && paper.language === 'ja' && paper.titleEn) {
    return paper.titleEn;
  }
  return paper.title;
}

function displayVenue(paper: Paper, lang: Lang): string {
  if (lang === 'en' && paper.language === 'ja' && paper.venueEn) {
    return paper.venueEn;
  }
  return paper.venue;
}

const title = displayTitle(paper, lang);
const venue = displayVenue(paper, lang);
const showJpBadge = lang === 'en' && paper.language === 'ja';
// Full-text link. For a whole conference abstract book `pdfPage` becomes a
// #page= fragment, so the viewer opens at this entry's own abstract.
const pdfHref =
  paper.pdf && paper.pdfPage ? `${paper.pdf}#page=${paper.pdfPage}` : paper.pdf;

// The label says what the link opens whenever that is not simply the
// published PDF of the entry itself (see `pdftype` in scripts/bib2json.mjs).
function pdfLabel(paper: Paper, lang: Lang): string {
  switch (paper.pdfType) {
    case 'aam':
      return lang === 'ja' ? 'PDF（受理稿）' : 'PDF (accepted manuscript)';
    case 'abstracts':
      return lang === 'ja'
        ? `発表論文集 PDF（p. ${paper.pdfPage}）`
        : `Abstracts PDF (p. ${paper.pdfPage})`;
    case 'program':
      return lang === 'ja'
        ? `大会プログラム PDF（p. ${paper.pdfPage}）`
        : `Conference program PDF (p. ${paper.pdfPage})`;
    case 'researchgate':
      return lang === 'ja' ? '全文（ResearchGate）' : 'Full text (ResearchGate)';
    default:
      return 'PDF';
  }
}

// External link target for the title. DOI wins over a bare `url`, which in
// turn wins over `pdf`; when none of the three exists the title stays plain
// text. The meta row below mirrors this: a `DOI: <doi>` link when a DOI is
// present, otherwise a bare `Link` when only `url` is set, and nothing at all
// when the entry has no external target. `pdf` is additive rather than
// exclusive: it renders its own full-text link next to whichever of those is
// shown, so one entry can point at both a proceedings volume (`url`) and the
// full text of the paper itself (`pdf`).
const doiHref = paper.doi ? `https://doi.org/${paper.doi}` : (paper.url ?? pdfHref);
const editorIsSelf =
  !!paper.editor && (paper.editor.includes('貞村') || paper.editor.includes('Sadamura'));

// Page ranges reach the content layer exactly as the bib writes them
// (scripts/bib2json.mjs decodes LaTeX in the text fields but deliberately
// leaves `pages` untouched), so a range still reads `30--31` here. Render the
// LaTeX dashes as the typographic ones the bibliography style calls for,
// without rewriting the stored value.
const pagesLabel = paper.pages?.replace(/---/g, '—').replace(/--/g, '–') ?? null;

// Conference dates read YYYY-MM-DD. The bib stores the month as a name
// (`October`), so use the parsed `monthNum`; the raw text is only a fallback
// for a month bib2json could not parse.
const pad2 = (v: string | number) => String(v).padStart(2, '0');
const dateParts: string[] = [paper.yearText ?? String(paper.year)];
if (paper.pubtype === 'conference' && paper.month) {
  const mm = paper.monthNum ? pad2(paper.monthNum) : paper.month;
  dateParts.push(paper.day ? `${mm}-${pad2(paper.day)}` : mm);
}
const dateLabel = dateParts.join('-');
---

<li
  class="pub-entry"
  data-type={paper.pubtype}
  data-year={String(paper.year)}
  data-topics={paper.topics.join(',')}
>
  <div class="pub-entry__authors">
    {paper.authors.map((a, i) => (
      <>
        {i > 0 ? ', ' : ''}
        {a.isSelf
          ? <strong class="self">{displayAuthor(a.name, lang)}</strong>
          : <span>{displayAuthor(a.name, lang)}</span>}
      </>
    ))}
    {paper.editor && paper.authors.length === 0 ? (
      <span>
        {editorIsSelf
          ? <strong class="self">{displayAuthor(paper.editor, lang)}</strong>
          : <span>{displayAuthor(paper.editor, lang)}</span>}
        {paper.role ? ` (${roleLabel(paper.role, lang)})` : ' (ed.)'}
      </span>
    ) : null}
    <span> ({paper.yearText ?? paper.year}).</span>
  </div>

  <div class="pub-entry__title">
    {doiHref
      ? <a href={doiHref} rel="noopener external" target="_blank">{title}</a>
      : <span>{title}</span>}
  </div>

  <div class="pub-entry__meta">
    {venue && <em>{venue}</em>}
    {paper.volume && <span>{paper.volume}{paper.number ? `(${paper.number})` : ''}</span>}
    {pagesLabel && <span>{pagesLabel}</span>}
    {paper.doi && (
      <span>
        DOI: <a href={`https://doi.org/${paper.doi}`} rel="noopener external" target="_blank">{paper.doi}</a>
      </span>
    )}
    {!paper.doi && paper.url && (
      <span>
        <a href={paper.url} rel="noopener external" target="_blank">Link</a>
      </span>
    )}
    {pdfHref && (
      <span>
        <a href={pdfHref} rel="noopener external" target="_blank">{pdfLabel(paper, lang)}</a>
      </span>
    )}
    {paper.note && <span>({paper.note})</span>}
    {paper.pubtype === 'conference' && <span>{dateLabel}</span>}
    {showJpBadge && <span class="pub-entry__lang-badge" aria-label="In Japanese">JP</span>}
  </div>
</li>

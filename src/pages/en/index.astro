---
import BaseLayout from '@layouts/BaseLayout.astro';

const title = 'Masahiro Sadamura | Legal Psychology & Sentencing Research (Japan)';
const description =
  'Researcher in legal psychology in Japan studying how welfare-related information about defendants shapes sentencing — combining vignette experiments, NLP of judicial texts, and explainable AI. Graduate School of Human Sciences, The University of Osaka.';

// 日本司法福祉学会の英語表記は、本サイトの既存表記（/en/profile の Professional
// Affiliations）に合わせて "Japanese Society of Law and Forensic Social Services" を用いる。
// 学会自身の確定英名は未確認で、手元資料には "Japanese Society for Law and ...",
// "Japan Society for Legal and Forensic Social Services (JSLFSS)" の揺れがある。
// サイト内の表記統一を優先した暫定形であり、一次確認が取れたら両頁を同時に改める。
// 発表題目の英訳も暫定訳（2026-08-30 起案）で、正典訳が確定したら差し替える。
---

<BaseLayout title={title} description={description}>
  <h1>Masahiro SADAMURA</h1>

  <p>
    Researcher in legal psychology at the Graduate School of Human Sciences,
    The University of Osaka.
  </p>

  <p>
    He studies how Japanese criminal justice handles welfare-oriented
    information about defendants — developmental background, disability, and
    social isolation — in sentencing. His work combines vignette experiments
    with natural language processing of Japanese court decisions and explainable
    machine learning (SHAP). Recent work includes a
    <a href="/en/lab/r8-tanto">pre-registered public verification</a> of
    AI-derived answers to the Japanese bar examination.
  </p>

  <h2>News</h2>
  <ul>
    <li>
      Presented "Welfare Support Information and Sentencing under an Institutional Vacuum"
      as a single-authored talk at the 26th Annual Congress of the Japanese Society of Law
      and Forensic Social Services (Rissho University, Shinagawa Campus, Tokyo) on
      August 30, 2026.
      <a href="/files/sadamura_20260830_jslfsw26_slides.pdf" target="_blank" rel="noopener">Slides (PDF, in Japanese)</a>
    </li>
  </ul>


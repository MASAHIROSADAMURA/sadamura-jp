---
import BaseLayout from '@layouts/BaseLayout.astro';

// zh 版のサービス一覧。価格は ja / en 版と同額で、以下の書き分けを守る。
//
//   - 可視テキストの金額は全て「日元」を明示する。中国語圏では ¥ が人民元と
//     読まれ、20 倍前後の誤読になるため。JSON-LD の priceCurrency は JPY。
//   - 同業への比較貶下は書かない（中国広告法 13 条）。他社の違法性を断定せず、
//     監督官庁の処分事例の引用にとどめる。
//   - 商品名に「等」を付けない。卒業生の資格が及ぶ学校（拉萨尔）と、それ以外の
//     寄宿校の相談とは分けて書く。
//   - サービス名は「AI回答引用核实」に統一する（「審計」と混在させない）。
//   - 日本語由来で中国語として意味の通らない語（法人／名义／书面／第一手资料／
//     坐实）は使わない。
//   - 取引条件（前払・返金・納期・法定書面・準拠法・管轄・事業者情報の開示方法）
//     は「交易条件（要点）」として中国語でも掲載する。日文 /legal にしか無いと、
//     中国語話者が取引条件を読めないため。
//   - 特定継続的役務提供の閾値は法文どおり「超过5万日元」。
//   - keywords に「教授内诺」を入れない（本ページ自身が危険信号として挙げる語）。
//   - 引用核实は「原文提示」型として記述する（実在・書誌一致＋該当箇所の原文＋
//     所在情報まで。主張を支持するかの判定は含まない）。確認できない場合と、
//     裁判所サイトで不ヒットの場合の扱いも本文に置く。
//
// 引用符は中国語組版の全角「“ ”」に統一。/zh/contact・/zh/guide への導線あり。
const title = '服务与价格：研究计划书辅导・AI回答引用核实・日本文献调研 | 贞村真宏';
const description =
  '日本读研・读博一对一指导：初次战略咨询33,000日元，研究计划书套餐（3个月）880,000日元；日本判例・文献・制度调研110,000日元起；AI回答引用核实33,000日元/件。中文沟通全程可。不代办签证，不作保录承诺。';
const keywords =
  '日本读研 指导,研究计划书 辅导,日本大学院 申请,日本文献 调查,AI引用 核实,日本寄宿中学,升学咨询 价格';

const siteOrigin = Astro.site?.origin ?? 'https://sadamura.jp';
const pageUrl = new URL(Astro.url.pathname, siteOrigin).toString();

// 「常见问题」。表示用の本文と FAQPage 構造化データをこの一つの配列から生成する
// ため、両者は構造上つねに逐語一致する。
const faq = [
  {
    q: 'Q. 能保证录取吗？',
    a: '不能——本站不作任何“保录”“保过”承诺，也不销售此类商品。日本大学院的入学选拔由各研究科自主实施，录取结果本来就不是任何第三方可以出售的东西。在中国，教育培训广告作出保证性承诺，已有被认定为违法广告并作出处罚的先例：北京市怀柔区市场监管局于2024年12月3日对含“保过、签订保过协议”等表述的广告作出处罚决定，该案由北京市市场监督管理局于2025年7月15日作为典型案例公布。本站提供的是研究者本人的一对一指导，以及全程可验证的过程。'
  },
  {
    q: 'Q. 人在中国大陆，可以远程接受指导吗？',
    a: '可以。咨询与指导全程在线进行，时差仅1小时。付款目前支持日本国内银行转账与国际汇款（Wise），支付宝／微信支付陆续开通；跨境汇款请自行确认所在地的外汇管理规定。'
  },
  {
    q: 'Q. 需要什么样的日语水平？',
    a: '视目标院校与专业而定。前期沟通与构思可用中文进行，研究计划书的最终产出为学术日语（或目标项目要求的语言），指导过程中会逐步完成这一转换。'
  },
  {
    q: 'Q. 可以代办在留资格（签证）吗？',
    a: '不能。有偿代为制作、提交在留资格（签证）申请文书，属于日本行政书士（专办行政机关申请文书的国家资格）或律师的专属业务。本站不代办、不介绍、不收取任何介绍费；您可通过日本行政书士会连合会的公开会员检索自行查找。'
  },
  {
    q: 'Q. 为什么反复强调“第一手资料”？',
    a: '因为日本的判例全文、判例评释、立法资料与大量学术文献，有相当大一部分只存在于纸面或付费数据库中，不在公开互联网上——通用AI检索不到它们。核实的做法分两步：能在线确认的（法条、裁判所网站公开的判例、J-STAGE与CiNii上的论文），在线上逐条核对；只存在于纸面的（判例评释、未数字化的大学学报、立案担当者解说），到国立国会图书馆等处调阅原件核对。两种情形都会附上该处的原文与所在信息。'
  },
  {
    q: 'Q. 实际指导的老师是谁？',
    a: '全部由本人（东京大学法务博士〔专业学位〕・同行评审论文21篇）一对一进行（无助教、无转手）。本人不是律师，本站不提供法律服务。'
  },
  {
    q: 'Q. 我用能联网的AI自己核实引用，不行吗？',
    a: '可以，而且应该先自己做一遍——书目层面的核对，用CiNii、J-STAGE、裁判所网站，几分钟就能完成，这一步不需要花钱。但有三件事目前联网AI做不到：①纸质的判例评释与未数字化的大学学报本来就不在网上，检索不到不等于不存在；②即便是接入了法律数据库的专业检索工具（Lexis+ AI、Westlaw AI-Assisted Research），经同行评审的实测研究报告的幻觉率仍在17%～33%之间（Magesh 等，Journal of Empirical Legal Studies 22(2), 216–242, 2025）；③页码，以及“该文献是否真的写了你引用的那句话”，必须读到原文才能判定。本站做的是后两件，并把该处的原文抄给您。'
  }
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  '@id': `${pageUrl}#faq`,
  inLanguage: 'zh-CN',
  isPartOf: { '@id': `${siteOrigin}/#website` },
  mainEntity: faq.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: f.a
    }
  }))
};

// Service × 4。name / description / offers の文言は本ページ
// 本文からの逐語抜粋で、価格は掲載値と一致する。「起」表記のものは price に
// 下限値を置き、範囲であることは offer の description に残す。
// 表示は「日元」だが priceCurrency は JPY のまま（機械可読側は変更しない）。
const provider = { '@id': `${siteOrigin}/#person` };
const areaServed = [
  { '@type': 'Country', name: 'Japan' },
  { '@type': 'Country', name: 'China' }
];
const availableLanguage = ['zh', 'ja', 'en'];

const serviceDefs = [
  {
    id: 'citation-audit',
    name: 'AI回答引用核实',
    serviceType: 'AI回答引用核实',
    description:
      '逐条核实AI输出中的日本判例、法条、文献是否真实存在、书目信息是否与原典一致，并把该处的原文（被引用的那一段）与所在信息一并写入核实报告。不判断该引用是否支持委托方的主张。不含任何个案法律意见：涉及具体纠纷、案件的委托恕不受理（日本《弁護士法》〔律师法〕第72条）。',
    offers: [
      {
        price: '33000',
        description: '33,000日元/件（含5条引用、3个工作日）。超出部分每条追加5,500日元'
      }
    ]
  },
  {
    id: 'research',
    name: '文献・制度调研',
    serviceType: '文献调研',
    description:
      '基于国立国会图书馆等第一手资料的调查报告（要旨、分析、全部出处）。调查对象限于一般性、抽象性的制度、判例与文献动向。标准交付期5个工作日起。不含任何个案法律意见：涉及具体纠纷、案件的委托恕不受理（日本《弁護士法》〔律师法〕第72条）；亦不承接税务咨询与个案税务判断（日本《税理士法》第52条）。',
    offers: [
      {
        price: '110000',
        description: '110,000日元起/件（根据调查范围与工作量单独报价、标准交付期5个工作日起）'
      }
    ]
  },
  {
    id: 'admissions-coaching',
    name: '大学院升学一对一指导',
    serviceType: '大学院升学指导',
    description:
      '先行研究地图／辅导课12次／研究计划书修改12稿（追加修改每稿11,000日元）／联系教授的礼仪指导／模拟面试2次。全程中文可。',
    offers: [
      {
        price: '33000',
        description: '初次战略咨询60分钟（线上） 33,000日元（申请套餐时全额抵扣首期分期款）'
      },
      {
        price: '880000',
        description:
          '研究计划书套餐（3个月） 880,000日元 — 先行研究地图／辅导课12次／研究计划书修改12稿（追加修改每稿11,000日元）／联系教授的礼仪指导／模拟面试2次。套餐对价按月分3次预付（首两期各293,333日元、第三期293,334日元，合计880,000日元）'
      }
    ]
  },
  {
    id: 'boarding-school-strategy',
    name: '拉萨尔（La Salle）升学战略咨询（毕业生亲授）',
    serviceType: '升学战略咨询',
    description:
      '本人为鹿儿岛拉萨尔高中毕业生，就该校的报考战略、出愿规划、面试准备与寄宿生活实况提供咨询；其他寄宿名校的报考战略咨询亦可提供（非毕业生视角）。注：不提供学科补习。本服务与学校法人拉萨尔学园并无任何关系，未获该校认可、合作或推荐。',
    offers: [{ price: '55000', description: '90分钟 55,000日元' }]
  }
];

const servicesLd = serviceDefs.map((s) => ({
  '@context': 'https://schema.org',
  '@type': 'Service',
  '@id': `${pageUrl}#service-${s.id}`,
  name: s.name,
  serviceType: s.serviceType,
  description: s.description,
  inLanguage: 'zh-CN',
  provider,
  areaServed,
  availableLanguage,
  offers: s.offers.map((o) => ({
    '@type': 'Offer',
    priceCurrency: 'JPY',
    price: o.price,
    description: o.description,
    url: pageUrl,
    seller: { '@id': `${siteOrigin}/#person` }
  }))
}));
---

<BaseLayout title={title} description={description} keywords={keywords}>
  <h1>服务与价格</h1>

  <p>
    所示价格均为日元。未标注“起”的项目为<strong>最终应付总额</strong>；<strong>标注“起”的项目为最低价，最终金额以报价单为准</strong>（AI回答引用核实每件含5条引用，超出部分每条追加5,500日元）。汇款手续费由委托方承担。本站尚未登记为日本消费税的适格发票（<span lang="ja">適格請求書</span>）开具事业者，因此无法开具适格发票。付款支持日本国内银行转账与国际汇款（Wise）；支付宝／微信支付陆续开通。<strong>汇款人姓名（账户户名）须与合同签约人一致。</strong>
  </p>

  <ul>
    <li id="service-citation-audit">
      <strong>AI回答引用核实</strong> — <strong>33,000日元/件</strong>（含5条引用、3个工作日）。逐条核实AI输出中的日本判例、法条、文献<strong>是否真实存在、书目信息是否与原典一致</strong>，并把<strong>该处的原文（被引用的那一段）</strong>与所在信息（藏馆、索书号、卷号页码、网址）一并写入核实报告。<strong>超出5条的部分，每条追加5,500日元。</strong>公开数据库中无法确认的，记为“<strong>无法确认</strong>”，并写明可继续追查的途径（藏馆、付费数据库、远程复印）。裁判所网站的判例检索<strong>并未收录全部裁判文书</strong>，因此检索不到不会被判定为“不存在”。⚠️ <strong>不含任何个案法律意见</strong>：涉及具体纠纷、案件的委托恕不受理（日本<span lang="ja">《弁護士法》</span>〔律师法〕第72条）；核实的范围仅限于引用是否真实存在、被引用的表述是否与原典一致，<strong>不判断该引用是否支持您的主张或结论，也不判断其内容在法律上是否成立</strong>。报告是供委托方内部使用的资料，不作为向第三方证明事实的文件出具。
    </li>
    <li id="service-research">
      <strong>文献・制度调研</strong> — <strong>110,000日元起/件</strong>（根据调查范围与工作量单独报价，<strong>标准交付期5个工作日起</strong>）。基于国立国会图书馆等第一手资料的调查报告（要旨、分析、全部出处），<strong>调查对象限于一般性、抽象性的制度、判例与文献动向</strong>。⚠️ <strong>不含任何个案法律意见</strong>：涉及具体纠纷、案件的委托恕不受理（日本<span lang="ja">《弁護士法》</span>〔律师法〕第72条）；<strong>亦不承接税务咨询与个案税务判断</strong>（在日本属于<span lang="ja">税理士</span>的专属业务），以及在留资格、许可认可等向行政机关提交文书的相关业务。报告是供委托方内部使用的资料，不作为向第三方证明事实的文件出具。
    </li>
    <li id="service-admissions-coaching">
      <strong>大学院升学一对一指导</strong> — 初次战略咨询60分钟（线上） <strong>33,000日元</strong>／<strong>研究计划书套餐（3个月）880,000日元</strong>：先行研究地图／<strong>辅导课12次</strong>／<strong>研究计划书修改12稿</strong>（追加修改每稿11,000日元）／联系教授的礼仪指导／<strong>模拟面试2次</strong>。注：初次战略咨询费用，在<strong>咨询之日起6个月内</strong>申请研究计划书套餐时全额抵扣<strong>首期分期款</strong>（限一次）；抵扣后如对套餐行使冷静期解约或中途解约，已抵扣的咨询费一并纳入结算。<strong>用AI写的初稿，由本人逐条回到原典为您核实。</strong>全程中文可。<br />
      <strong>付款方式</strong>：研究计划书套餐的对价<strong>按月分3次预付（首两期各293,333日元、第三期293,334日元，合计880,000日元）</strong>；其他服务仍为着手前一次性全额预付。<br />
      <strong>受理状况</strong>：目前仅受理初次战略咨询；套餐的新规受理将在合同文本整备完成后开始，可先登记等候名单。<br />
      <strong>本人所在的大阪大学研究生院，其报考者的指导恕不受理</strong>——本人不参与该校的入学者选拔，也不为任何学校做教授的介绍、推荐或牵线。
    </li>
    <li id="service-boarding-school-strategy">
      <strong>拉萨尔（La Salle）升学战略咨询（毕业生亲授）</strong> — 90分钟 <strong>55,000日元</strong>。本人为鹿儿岛拉萨尔高中毕业生，就该校的报考战略、出愿规划、面试准备与寄宿生活实况提供咨询；<strong>其他寄宿名校的报考战略咨询亦可提供</strong>（非毕业生视角）。注：不提供学科补习。<strong>本服务与学校法人拉萨尔学园并无任何关系</strong>，未获该校认可、合作或推荐。
    </li>
    <li id="service-academic-support">
      <strong>学术支持</strong>（面向研究者与机构：大学、研究所、企业）：英文论文润色 80,000日元起／篇（5,000词左右）；日译英 15日元/字起；数据分析 200,000日元起。
    </li>
  </ul>

  <h2 id="compare">价格与内容一览</h2>

  <table>
    <thead>
      <tr>
        <th>服务</th>
        <th>价格（日元）</th>
        <th>交付期</th>
        <th>包含</th>
        <th>不包含</th>
      </tr>
    </thead>
    <tbody>
      <tr>
        <td>AI回答引用核实</td>
        <td>33,000／件（含5条）<br />超出每条 5,500</td>
        <td>3个工作日（全部可在线确认时）；需调阅纸质资料时另行告知</td>
        <td>实在与书目的核对、该处原文的摘录、所在信息、无法确认时的追查途径</td>
        <td>个案法律意见；该引用是否支持您的主张的判断；代写</td>
      </tr>
      <tr>
        <td>文献・制度调研</td>
        <td>110,000<strong>起</strong>／件（以报价单为准）</td>
        <td>5个工作日起（以报价单为准）</td>
        <td>要旨、分析、全部出处与所在信息</td>
        <td>个案法律意见；税务咨询与个案税务判断；在留资格・许可认可的申请文书</td>
      </tr>
      <tr>
        <td>大学院升学一对一指导（初次战略咨询）</td>
        <td>33,000／60分钟</td>
        <td>到款确认后14日以内实施</td>
        <td>现状诊断、路线与院校方向的判断、可行性的说明</td>
        <td>合格保证；出愿代办；材料翻译；签证</td>
      </tr>
      <tr>
        <td>研究计划书套餐（3个月）</td>
        <td>880,000</td>
        <td>合同文本所定的3个月</td>
        <td>先行研究地图、辅导课12次、研究计划书修改12稿（追加修改每稿11,000日元）、联系教授的礼仪指导、模拟面试2次</td>
        <td>合格保证；出愿代办；材料翻译；签证；学科补习；本人所在的大阪大学研究生院的报考者指导</td>
      </tr>
      <tr>
        <td>拉萨尔（La Salle）升学战略咨询</td>
        <td>55,000／90分钟</td>
        <td>到款确认后14日以内实施</td>
        <td>报考战略、出愿规划、面试准备、寄宿生活实况</td>
        <td>学科补习；与该校的任何关系（本站与学校法人拉萨尔学园无关）</td>
      </tr>

---
import '@styles/global.css';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import SEO from '@components/SEO.astro';
import { getLangFromUrl, useTranslations, langTag } from '@i18n/index';

export interface Props {
  title: string;
  description: string;
  /** Optional Open Graph image URL (relative or absolute). Defaults to /og.png. */
  image?: string;
  /** Override the canonical path. Defaults to Astro.url.pathname. */
  canonicalPath?: string;
  /** Last update date in ISO YYYY-MM-DD. Defaults to today. */
  lastUpdated?: string;
  /** Optional comma-separated keyword list (legacy CN engines only). */
  keywords?: string;
  /** Override the last BreadcrumbList label (slug routes such as /zh/guide/*). */
  breadcrumbLabel?: string;
}

const { title, description, image, canonicalPath, lastUpdated, keywords, breadcrumbLabel } =
  Astro.props;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
// Anchor "today" to Asia/Tokyo (JST). UTC-derived dates flip a day too
// early when the build runs late-evening JST.
const today = new Intl.DateTimeFormat('en-CA', {
  timeZone: 'Asia/Tokyo',
  year: 'numeric',
  month: '2-digit',
  day: '2-digit'
}).format(new Date());
const updated = lastUpdated ?? today;
---

<!doctype html>
<html lang={langTag[lang]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <!-- Web font: BIZ UDPGothic 400/700 — fallback when UD デジタル教科書体 is
         absent on the client. Body prefers the textbook face; headings/nav/tables
         are gothic. Only font loaded (display=swap, preconnected).
         2026-08-01: 中国大陸からは fonts.googleapis.com に到達できず、
         render-blocking な <link rel="stylesheet"> だと TCP タイムアウトまで
         白画面になるため、非ブロッキング読み込み（media="print" → onload で
         all に切替）に変更。フォントが取れなくても本文はフォールバック
         フォントで即時表示される。 -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&display=swap"
      media="print"
      onload="this.media='all';this.onload=null;"
    />
    <noscript>
      <link
        rel="stylesheet"
        href="https://fonts.googleapis.com/css2?family=BIZ+UDPGothic:wght@400;700&display=swap"
      />
    </noscript>

    <SEO
      title={title}
      description={description}
      image={image}
      canonicalPath={canonicalPath}
      lang={lang}
      keywords={keywords}
      breadcrumbLabel={breadcrumbLabel}
    />

    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#1a1a1a" />
    {
      /* The feed is Japanese-only (`<language>ja</language>`, JA publication
         titles), so it is advertised from JA pages only. Announcing it from the
         EN/ZH heads under a translated title promised content the feed does not
         carry (2026-08-01 ruling). */
      lang === 'ja' && (
        <link rel="alternate" type="application/rss+xml" title={t('rss.title')} href="/rss.xml" />
      )
    }
    <link rel="me" href="https://researchmap.jp/sadamuramasahiro" />
    <link rel="me" href="https://orcid.org/0009-0008-2248-4583" />
  </head>

  <body>
    <a href="#main" class="skip-link">{t('a11y.skipToMain')}</a>
    <Header />
    <main id="main">
      <slot />
      <p style="margin-top: 3rem; font-size: 0.85rem; color: var(--color-muted);">
        <small>{t('common.lastUpdated')}: <time datetime={updated}>{updated}</time></small>
      </p>
    </main>
    <Footer />
  </body>
</html>
